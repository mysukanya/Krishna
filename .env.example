# ==============================================================================
# KRISHNA AUTONOMOUS AGENT CONFIGURATION
# ==============================================================================

# Project Information
PROJECT_NAME="Krishna: Autonomous Agentic AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# LLM Provider Configuration
# Options: "mock" (offline/test), "openai", "gemini", "anthropic"
LLM_PROVIDER="mock"
LLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=30.0

# Vector Memory & Embeddings
# Options for store: "chroma", "inmemory"
VECTOR_STORE_TYPE="chroma"
CHROMA_PERSIST_DIRECTORY="./data/chromadb"
CHROMA_COLLECTION_NAME="krishna_memory"

# Embedding Provider
# Options: "chroma_default", "openai", "mock"
EMBEDDING_PROVIDER="chroma_default"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Bounded Execution Limits & Safety Guards
MAX_ITERATIONS=10
MAX_TOOL_RETRIES=3
TOOL_TIMEOUT_SECONDS=15.0
REQUIRE_HUMAN_APPROVAL_HIGH_RISK=true

# Allowlisted Domains for HTTP Tool (SSRF Protection)
ALLOWED_HTTP_DOMAINS='["api.github.com", "httpbin.org", "jsonplaceholder.typicode.com", "en.wikipedia.org", "dummyjson.com"]'

# Server Network Configuration
HOST="0.0.0.0"
PORT=8000
